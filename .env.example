# ==============================================================================
# Environment Configuration Template
# Duplicate this file to .env (or src/.env) and populate with your credentials.
# DO NOT commit real API keys or secrets to version control.
# ==============================================================================

# ── Google Gemini (LLM + Embeddings) ──────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash"

# ── PostgreSQL (app DB + PgVector + LangGraph checkpointer) ───────────────────
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="ops_db"
DB_USERNAME="postgres"
DB_PASSWORD="your-secure-password-here"   # required — no default

# ── FastAPI server ─────────────────────────────────────────────────────────────
HOST="127.0.0.1"
PORT="8080"

# ── MLflow observability ───────────────────────────────────────────────────────
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_EXPERIMENT_NAME="ops_assistant"
