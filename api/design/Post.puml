activate Client
activate Main

    group Main
        group initialize_config — fetch server configuration
            Main -> Main : call fetch_server_config to load configuration
            Main -> AppSettings : move to AppSettings to load config
            activate AppSettings
            group AppSettings
                group Config
                    AppSettings -> AppSettings : read configuration values from environment
                    AppSettings --> Main : return server_config
                end
            end
            deactivate AppSettings
            Main -> Main : store returned values in server_config variable
        end

        group create_app — initialize FastAPI application
            Main -> Main : initialize FastAPI and store in app variable
            Main -> Main : attach CORSMiddleware with allowed_methods and allow_origins
            Main -> Main : register router in app
            Main -> Migration : move to Migration to run database migration
            activate Migration
            group Migration
                group initialize_database — set up database tables
                    Migration -> Database : create database instance and session
                    activate Database
                    group Database
                        group __new__ — singleton initialization
                            note over Database
                                Singleton __new__ called
                                _instance is None → create new instance
                            end note
                            Database -> Database : call super.__new__ if instance not yet created
                            Database -> Database : call initialize_engine to set up engine
                            Database -> Database : call create_engine to create single engine instance
                            Database -> Database : call sessionmaker to create session factory
                            Database --> Database : engine initialized successfully
                            Database -> Database : reuse singleton database instance across all operations
                        end
                        Database --> Migration : return database_instance
                    end
                    deactivate Database
                    Migration -> Migration : migration and seeding completed successfully
                    Migration --> Main : return control to Main
                end
            end
            deactivate Migration
            Main -> Main : register global exception handler for pydantic validation errors
        end

        group run_local_server — start uvicorn server
            Main -> Main : call create_app and store result in app variable
            Main -> Main : start uvicorn with app, host, and port from server_config
        end
    end

Client -> Main : POST /api/v1/chatbot/123e4567-e89b-12d3-a456-426655440000
    note over Main
        Request Body:
        {
          "user_query": "generate a code",
          "thread_id": "123e4567-e89b-12d3-a456-426655440000"
        }
    end note

    Main -> AgentRouter : forward request to AgentRouter
    activate AgentRouter
    AgentRouter -> ValidationModel : fetch APIResponse and UserRequest models
            activate ValidationModel
            group ValidationModel
                group APIResponse | UserRequest — validation models
                    ValidationModel -> ValidationModel : return requested validation models
                    ValidationModel --> AgentRouter : return validation models
                end
            end
            deactivate ValidationModel
    group AgentRouter
        group init — dependencies
            AgentRouter -> AgentRouter : create agent_service variable and assign AgentService instance
        end
        group process_query_route — validate and route user query
            AgentRouter -> AgentRouter : validate UUID path parameter via pydantic global validator
            AgentRouter -> AgentRouter : create request_id and assign new UUID value
            alt try
                AgentRouter -> AgentRouter : parse request body using request.json and store in request_payload
                alt if error during JSON parsing
                    AgentRouter -> AgentRouter : raise exception — JSON parsing failed
                end
                alt if user_query field is missing
                    AgentRouter -> AgentRouter : raise NotFoundException — user_query is required
                end
                AgentRouter -> AgentRouter : create UserRequest instance and pass request_payload for validation
                AgentRouter -> AgentService : call agent_service with request_data as argument
                activate AgentService
                group AgentService
                    group __init__ — initialize service dependencies
                        AgentService -> AgentService : create GraphNodes instance and store in graph_nodes variable
                        AgentService -> AgentService : create ConditionalEdges instance and store in conditional_edges variable
                        AgentService -> ValidationModel : get the State model
                        activate ValidationModel
                        group ValidationModel
                            group State — graph state model
                                ValidationModel -> ValidationModel : return State model
                                ValidationModel --> AgentService : return State model
                            end
                        end
                        deactivate ValidationModel
                    end

                    group agent_service — orchestrate agent call
                        alt try
                            AgentService -> AgentService : create checkpointer using connection string
                            AgentService -> AgentService : call setup on checkpointer to create tables
                            AgentService -> AgentService : call graph_builder to build the agent flow and pass the checkpointer

                            group graph_builder — build the LangGraph workflow
                                alt try
                                    AgentService -> AgentService : create StateGraph and pass the defined custom State
                                    AgentService -> AgentService : add node user_intent_identifier from graph_nodes instance
                                    AgentService -> AgentService : add node code_agent_node from graph_nodes instance
                                    AgentService -> AgentService : add node review_agent_node from graph_nodes instance
                                    AgentService -> AgentService : add node research_agent_node from graph_nodes instance
                                    AgentService -> GraphNodes : move node definitions to GraphNodes
                                    activate GraphNodes
                                    group GraphNodes
                                        group __init__ — initialize agent and llm instances
                                            GraphNodes -> GraphNodes : create CoderAgent instance and store in code_agent variable
                                            GraphNodes -> GraphNodes : create ResearcherAgent instance and store in research_agent variable
                                            GraphNodes -> GraphNodes : create ReviewerAgent instance and store in review_agent variable
                                            GraphNodes -> GraphNodes : create DecisionMakerLlm instance and store in decision_llm variable
                                        end

                                        GraphNodes -> Agent : move to base Agent class
                                        activate Agent
                                        group Agent
                                            group __init__ — initialize agent dependencies
                                                Agent -> Agent : create PromptBuilder instance and store in prompt_builder variable
                                                Agent -> Agent : create AgentBuilder instance and store in agent_builder variable
                                                Agent -> Agent : create LlmResponseHandler instance and store in llm_response_handler variable
                                                Agent -> Agent : create McpLoader instance and store in mcp_loader variable
                                            end

                                            group invoke_agent — build and run agent
                                                alt try
                                                    Agent -> Agent : call fetch_system_prompt using prompt_builder and pass agent name as argument
                                                    Agent -> PromptBuilder : move to PromptBuilder to get system prompt
                                                    activate PromptBuilder
                                                    group PromptBuilder
                                                        group fetch_system_prompt — return configured system prompt
                                                            PromptBuilder -> PromptBuilder : return system_prompt string based on name parameter
                                                            note over PromptBuilder
                                                         SYSTEM_PROMPT = """
                                                            <Role>
                                                            You are an expert Python code generator in a multi-agent pipeline.
                                                            </Role>

                                                            <Objective>
                                                                You receive inputs from two upstream agents:
                                                                - researcher_output: relevant docs, APIs, patterns, and examples (may be empty)
                                                                - reviewer_feedback: improvement suggestions on previously generated code (may be empty)
                                                                
                                                                Always prioritize reviewer_feedback over your own assumptions when present.
                                                                Always use researcher_output as your technical reference when present.
                                                            </Objective>

                                                            <Instructions>
                                                                1. Analyze the user query precisely 
                                                                2. If researcher_output is present, base your implementation on it use research output details
                                                                3. If reviewer_feedback is present, fix ONLY what is flagged — don't rewrite unrelated parts.
                                                                4. Write clean, production-ready Python.
                                                                5. Always include:
                                                                    - Type hints on all functions
                                                                    - Docstrings (one-liner for simple, full for complex)
                                                                    - Inline comments for non-obvious logic
                                                                    - Error handling where failure is likely
                                                            </Instructions>

                                                            <constraints>
                                                                - Python only. No other languages.
                                                                - If the query is unclear, ask ONE specific clarifying question before generating.
                                                                - Do not repeat reviewer feedback back - just apply it.
                                                            </constraints>
                                                            """
                                                                    elif(name=="Reviewer"):
                                                                        SYSTEM_PROMPT = """
                                                            <Role>
                                                            You are a senior Python code reviewer in a multi-agent pipeline.
                                                            </Role>

                                                            <Objective>
                                                                You receive code generated by a coder agent.
                                                                Your feedback goes directly back to the coder agent for revision.
                                                                Be specific enough that the coder can fix issues without guessing.
                                                            </Objective>
                                                            <Review_checklist>
                                                                Check strictly in this order:
                                                                Correctness    - Does the code actually solve the user's request?
                                                                Error handling - Are failures caught and handled gracefully?
                                                                Type hints     - All functions must have input/output type hints
                                                                Docstrings     - Present and meaningful (not just restating the function name)
                                                                Optimization   - No redundant loops, unnecessary imports, or memory waste
                                                                Security       - No hardcoded secrets, unsafe evals, or SQL injections
                                                            </Review_checklist>
                                                            <output_format>
                                                                - If status is "pass", issues can be empty or contain minor suggestions.
                                                                - If status is "fail", at least one critical or major issue must be present.
                                                                - Never return "fail" without actionable fixes.
                                                            </output_format>
                                                            <constraints>
                                                                - Python only.
                                                                - Do not rewrite the code — only report issues.
                                                                - Do not pass code that is incorrect even if it looks clean.
                                                                - Follow the Review_checklist
                                                            </constraints>
                                                            """
                                                                    elif(name=="Researcher"):
                                                                    SYSTEM_PROMPT = """


                                                            <Role>
                                                                You are an Excelent Researcher who can understand the query give research context
                                                            </Role>
                                                            <Objective>
                                                                Extract specific, actionable research that directly serves the coder and reviewer agents.
                                                                Do NOT return generic overviews — return targeted facts, code patterns, docs, and examples.
                                                            </Objective>

                                                            <Instructions>
                                                                1. Analyze the both the user query and review output if present.
                                                                2. Research about the functionalities.
                                                                3. Give a detailed output about query.
                                                            </Instructions>

                                                            """
                                                                    elif(name=="Decider"):
                                                                        SYSTEM_PROMPT = """
                                                            <Role>
                                                                You are a decision-making and intent-identifier agent.
                                                                Analyze the user input and return output strictly in valid JSON format.
                                                            </Role>

                                                            <Objective>
                                                                - Identify the user's intent and route it to the correct agent.
                                                                - Ask for clarification when the user query is incomplete or ambiguous.
                                                                - Use previous conversation context to understand follow-up queries.
                                                                - Refuse requests that are not relevant to the business use case.
                                                            </Objective>

                                                            <Instructions>
                                                                1. Analyze the user query carefully.
                                                                2. Check whether the query is relevant to the business use case: coding, reviewing, or researching.
                                                                3. If the query is missing context or is too vague, set decision to "need_details" and ask for clarification in llm_response.
                                                                4. If the query is not relevant to the business, set relevant_to_business to false and explain in llm_response.
                                                                5. If previous conversation exists, check if the current query relates to it and set is_relevant_to_past_conversation accordingly.
                                                                6. Return ONLY a valid JSON object. Do NOT include markdown, code fences, or extra explanation.
                                                                7. Always use null (not None) for empty fields.
                                                                8. When you check for is_relevant_to_past_conversation check whether user query is contnuation.Even if the past and user_query have same words.Always analyze the query before makeing the decision.
                                                            </Instructions>

                                                            <Agents>
                                                                "coding"       - User wants ONLY code generated, no research needed.
                                                                "review"       - User provides existing code and wants it reviewed.
                                                                "research"     - User wants ONLY explanation, concepts, or documentation.
                                                                "both"         - User wants code generated AND a research/explanation.
                                                                "need_details" - Query is too vague or missing context; clarification is needed.
                                                            </Agents>

                                                            <Output>
                                                            Return ONLY this JSON with no additional text:
                                                            {
                                                                "decision": "coding" | "review" | "research" | "both" | "need_details",
                                                                "research_only": true | false,
                                                                "relevant_to_business": true | false,
                                                                "llm_response": "<message to user when clarification or refusal is needed>" | null
                                                            }

                                                            Rules:
                                                                - research_only is true ONLY when decision is "research", otherwise false.
                                                                - is_relevant_to_past_conversation is true only when past conversation exists AND the current query relates to it.
                                                                - llm_response must contain a message when decision is "need_details" or relevant_to_business is false.
                                                                - llm_response must be null when the intent is clear and no clarification is needed.
                                                                - "both" means decision="both" and research_only=false.
                                                                - Never use Python literals. Use JSON-compliant values: null, true, false.
                                                            </Output>
                                                            """
                                                            end note
                                                            PromptBuilder --> Agent : return system_prompt
                                                        end
