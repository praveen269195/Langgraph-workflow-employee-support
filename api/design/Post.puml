                                    AgentService -> AgentService : add conditional edge review_conditon and the dictionary of nodes where to route based on the returned boolean {True:END,False:"researcheragent"}
                                    AgentService -> AgentService : add conditional edge research_conditon and the dictionary of nodes where to route based on the returned boolean {True:END,False:"coderagent"}
                                    AgentService -> ConditionalEdges : move conditional edge definitions to ConditionalEdges
                                    activate ConditionalEdges
                                    group ConditionalEdges
                                        group route_intent — determine routing based on decision LLM output
                                            alt try
                                                alt if state - decision_llm_output has relevant_to_business is true
                                                    ConditionalEdges -> ConditionalEdges: pass the decision to the as decider dictionary get the apprpriate value
                                                    note over ConditionalEdges
                                                    intent_decider={
                                                        "coding":"code",
                                                        "review":"review",
                                                        "research":"research",
                                                        "both":"research",
                                                        "need_details":"need_details"
                                                    }
                                                    end note
                                                else
                                                    ConditionalEdges -> ConditionalEdges : return "rejected"
                                                end
                                            else exception
                                                ConditionalEdges --> AgentService : raise an exception if any error happens
                                            end
                                        end

                                        group review_condition — check if review passed
                                            alt try
                                                alt if reviewer_agent_output in state has review_passed as true
                                                    ConditionalEdges -> ConditionalEdges : return True
                                                else
                                                    ConditionalEdges -> ConditionalEdges : return False
                                                end
                                            else exception
                                                ConditionalEdges --> AgentService : raise an exception if any error happens
                                            end
                                        end

                                        group research_condition — check if research only
                                            alt try
                                                alt if decision_llm_output in state has research_only as true
                                                    ConditionalEdges -> ConditionalEdges : return True
                                                else
                                                    ConditionalEdges -> ConditionalEdges : return False
                                                end
                                            else exception
                                                ConditionalEdges --> AgentService : raise an exception if any error happens
                                            end
                                        end
                                    end
                                    deactivate ConditionalEdges

                                    AgentService -> AgentService : compile graph with checkpointer and store in compiled_graph variable
                                    AgentService --> AgentService : return compiled_graph
                                else exception
                                    AgentService --> AgentService : raise an exception if any error happens
                                end
                            end

                            AgentService -> AgentService : invoke compiled_graph with user_query and thread_id
                            AgentService -> AgentService  : call the output_formatter  function to format the output 
                            group output_formatter - format the response
                                alt try
                                    AgentService -> AgentService: create two varaible response and code with empty values
                                    AgentService -> AgentService : extract the decision from the decision-llm_output and store it in decision variable
                                    alt if state - decision_llm_output - relevant_to_business is not true
                                        AgentService ->AgentService : response equal to llm_response
                                    end
                                    alt elif if state - decision_llm_output - research_only is  true
                                        AgentService ->AgentService : response equal to research_agent_output
                                    end
                                    alt elif if state - decision_llm_output - review_only is true
                                            AgentService ->AgentService : response equal to review_agent_response improvements
                                    end
                                    alt
                                        alt decision is coding and both
                                            AgentService ->AgentService : response equal to code_agent_output response key
                                            AgentService ->AgentService : code equal to code_agent_output code key
                                        end
                                        alt decision is need_details
                                           AgentService ->AgentService : response equal to llm_response
                                        end
                                    end
                                    AgentService --> AgentService : return the response to the agent_service
                                    AgentService --> AgentRouter : response is returned to the router
                                    
                                else exception
                                AgentService --> AgentService : raise an exception if any error happens
                                end
                            end

                        else exception
                            alt if NotFoundError
                                AgentService -> AgentService : raise NotFoundException
                            end
                            alt if BadRequestError
                                AgentService -> AgentService : raise BadRequestException
                            end
                            note right AgentService
                                Error Response — 404:
                                {
                                  "code": 404,
                                  "status": "error",
                                  "message": "Error Occurred",
                                  "error": {
                                    "code": "002",
                                    "message": "id is not found"
                                  },
                                  "request_id": "req-123-456-789",
                                  "timestamp": "2024-01-01T12:00:00.000Z"
                                }
                            end note
                            AgentService --> AgentRouter : return error to AgentRouter
                        end
                    end
                end
                deactivate AgentService

                AgentRouter -> AgentRouter : call format_success_response with message, code, graph_response as arguments
                AgentRouter -> ResponseFormatter : move to ResponseFormatter to build success response
                activate ResponseFormatter
                group ResponseFormatter
                    group format_success_response — build API success response
                        ResponseFormatter -> ResponseFormatter : create success_response using APIResponse model
                        ResponseFormatter -> ValidationModel : fetch APIResponse model
                        activate ValidationModel
                        group ValidationModel
                            group APIResponse — response structure
                                ValidationModel -> ValidationModel : return APIResponse model
                                ValidationModel --> ResponseFormatter : return APIResponse model
                            end
                        end
                        deactivate ValidationModel
                        note right ResponseFormatter
                            Success Response — 200:
                            {
                              "code": 200,
                              "status": "success",
                              "message": "llm response is fetched",
                              "data": "The response of the llm",
                              "request_id": "ef5b4146-68ca-43e1-a32c-d875a3246be3",
                              "timestamp": "2026-01-21T14:33:52.540758"
                            }
                        end note
                        ResponseFormatter --> AgentRouter : return formatted_success_response
                    end
                end
                deactivate ResponseFormatter

                AgentRouter --> Main : return formatted_success_response
                note over Main
                    Success Response — 200:
                    {
                      "code": 200,
                      "status": "success",
                      "message": "llm response is fetched",
                      "data": {
                      "response":"The response of the llm",
                      "code": Optional - When there is code.
                      },
                      "request_id": "ef5b4146-68ca-43e1-a32c-d875a3246be3",
                      "timestamp": "2026-01-21T14:33:52.540758"
                    }
                end note
                Main --> Client : return success_response

            else exception
                alt if NotFoundError
                    AgentRouter -> AgentRouter : set code 404 and message "Not Found"
                end
                alt if DatabaseError
                    AgentRouter -> AgentRouter : set code 500 and message "Database Error"
                end
                alt if BadRequestError
                    AgentRouter -> AgentRouter : set code 400 and message "Bad Request"
                end

                AgentRouter -> AgentRouter : call format_error_response with message and code as arguments
                AgentRouter -> ResponseFormatter : move to ResponseFormatter to build error response
                activate ResponseFormatter
                group ResponseFormatter
                    group format_error_response — build API error response
                        ResponseFormatter -> ResponseFormatter : create error_response using APIResponse model
                        ResponseFormatter -> ValidationModel : fetch APIResponse model
                        activate ValidationModel
                        group ValidationModel
                            group APIResponse — response structure
                                ValidationModel -> ValidationModel : return APIResponse model
                                ValidationModel --> ResponseFormatter : return APIResponse model
                            end
                        end
                        deactivate ValidationModel
                        note right ResponseFormatter
                            Error Response — 500:
                            {
                              "code": 500,
                              "status": "error",
                              "message": "Error Occurred",
                              "error": {
                                "code": "001",
                                "message": "Server is not running"
                              },
                              "request_id": "123e4567-e89b-12d3-a456-426655440000",
                              "timestamp": "2024-01-01T12:00:00.000Z"
                            }
                        end note
                        ResponseFormatter --> AgentRouter : return formatted_error_response
                    end
                end
                deactivate ResponseFormatter

                AgentRouter --> Main : return formatted_error_response
                deactivate AgentRouter

                note over Main
                    Error Response — 500:
                    {
                      "code": 500,
                      "status": "error",
                      "message": "Error Occurred",
                      "error": { "code": "001", "message": "Server is not running" },
                      "request_id": "123e4567-e89b-12d3-a456-426655440000",
                      "timestamp": "2024-01-01T12:00:00.000Z"
                    }
                end note
                note over Main
                    Error Response — 404:
                    {
                      "code": 404,
                      "status": "error",
                      "message": "Error Occurred",
                      "error": { "code": "002", "message": "id is not found" },
                      "request_id": "123e4567-e89b-12d3-a456-426655440000",
                      "timestamp": "2024-01-01T12:00:00.000Z"
                    }
                end note
                note over Main
                    Error Response — 400:
                    {
                      "code": 400,
                      "status": "error",
                      "message": "Bad Request",
                      "error": { "code": "003", "message": "url or uuid in wrong format" },
                      "request_id": "123e4567-e89b-12d3-a456-426655440000",
                      "timestamp": "2024-01-01T12:00:00.000Z"
                    }
                end note
                note over Main
                    Error Response — 422:
                    {
                      "code": 422,
                      "status": "error",
                      "message": "Unprocessable Content",
                      "error": { "code": "004", "message": "Pydantic validation failed" },
                      "request_id": "123e4567-e89b-12d3-a456-426655440000",
                      "timestamp": "2024-01-01T12:00:00.000Z"
                    }
                end note
                Main --> Client : return error_response
            end
        end
    end

deactivate Main
